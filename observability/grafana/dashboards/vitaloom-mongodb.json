{
  "uid": "vitaloom-mongodb",
  "title": "VitaLoom MongoDB",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "vitaloom",
    "mongodb"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Metrics reporting",
      "description": "Shows whether Prometheus has current connection data from the MongoDB receiver.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "vitaloom-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(mongodb_connection_count{db_namespace=\"admin\",type=\"current\"}) > bool 0 or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "No data",
                  "color": "red"
                },
                "1": {
                  "text": "Reporting",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "textMode": "value",
        "colorMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Open connections",
      "description": "Current server connections, including idle connections.",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "vitaloom-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mongodb_connection_count{db_namespace=\"admin\",type=\"current\"}",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "decimals": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "textMode": "value",
        "colorMode": "none"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Available connections",
      "description": "Additional connections MongoDB can accept at the selected time.",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "vitaloom-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mongodb_connection_count{db_namespace=\"admin\",type=\"available\"}",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "decimals": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "textMode": "value",
        "colorMode": "none"
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Operations by type",
      "description": "Server-wide rates over a two-minute window for query, insert, update, and delete. MongoDB tracks generic commands separately.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 14,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "vitaloom-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(mongodb_operation_count_total{operation=~\"query|insert|update|delete\"}[2m])",
          "legendFormat": "{{operation}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic-by-name"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Open connections over time",
      "description": "A connection can remain open while idle. The available connection count appears above.",
      "gridPos": {
        "x": 14,
        "y": 4,
        "w": 10,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "vitaloom-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mongodb_connection_count{db_namespace=\"admin\",type=\"current\"}",
          "legendFormat": "Open",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
