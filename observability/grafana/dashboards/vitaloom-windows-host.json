{
  "uid": "vitaloom-windows-host",
  "title": "VitaLoom Windows Host",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "vitaloom",
    "windows"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "15s",
  "templating": {
    "list": [
      {
        "name": "nic",
        "label": "Network adapter",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "vitaloom-prometheus"
        },
        "definition": "label_values(windows_net_bytes_received_total, nic)",
        "query": {
          "query": "label_values(windows_net_bytes_received_total, nic)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Windows metrics source",
      "description": "Connectivity from the Collector container to windows_exporter on the Windows host.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "vitaloom-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(up{exported_job=\"windows-host\"}) or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Reporting",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "textMode": "value",
        "colorMode": "value"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU usage",
      "description": "Non-idle CPU time averaged across all logical processors.",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "vitaloom-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_max(clamp_min(100 * (1 - avg(rate(windows_cpu_time_seconds_total{mode=\"idle\"}[$__rate_interval]))), 0), 100)",
          "legendFormat": "Windows host",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Available RAM",
      "description": "Physical memory Windows can make available to workloads, including reclaimable standby memory.",
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "vitaloom-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "windows_memory_available_bytes",
          "legendFormat": "Available",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Free disk space",
      "description": "Percent of capacity still free for volumes with a drive letter.",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "vitaloom-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * windows_logical_disk_free_bytes{volume=~\"[A-Za-z]:\"} / windows_logical_disk_size_bytes{volume=~\"[A-Za-z]:\"}",
          "legendFormat": "{{volume}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Network throughput",
      "description": "Inbound and outbound bytes per second. Select the adapter carrying the traffic being measured.",
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "vitaloom-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(windows_net_bytes_received_total{nic=~\"${nic:regex}\"}[$__rate_interval])",
          "legendFormat": "RX · {{nic}}",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "expr": "rate(windows_net_bytes_sent_total{nic=~\"${nic:regex}\"}[$__rate_interval])",
          "legendFormat": "TX · {{nic}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Disk read and write latency",
      "description": "Mean milliseconds per completed I/O on each physical disk. Idle periods have no latency sample.",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "vitaloom-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * rate(windows_physical_disk_read_latency_seconds_total{disk!=\"_Total\"}[$__rate_interval]) / (rate(windows_physical_disk_reads_total{disk!=\"_Total\"}[$__rate_interval]) > 0)",
          "legendFormat": "Read · Disk {{disk}}",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "expr": "1000 * rate(windows_physical_disk_write_latency_seconds_total{disk!=\"_Total\"}[$__rate_interval]) / (rate(windows_physical_disk_writes_total{disk!=\"_Total\"}[$__rate_interval]) > 0)",
          "legendFormat": "Write · Disk {{disk}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
