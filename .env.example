# Application
SERVER_PORT=8080

# MongoDB replica set (host-run Spring Boot app connects through localhost)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=root
MONGO_PASS=change-me-local-root-password

# Least-privilege application database account
APP_DB=vitaloom_db
APP_USER=vitaloom_app
APP_PASSWORD=change-me-local-app-password

# Mongo Express local administration UI
ME_PORT=8081
ME_BASIC_USER=admin
ME_BASIC_PASS=change-me-local-admin-password

# Browser-based clients (native React Native requests are not subject to browser CORS)
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Mongo driver / optional transaction support
MONGO_SERVER_SELECTION_TIMEOUT_MS=2000
MONGO_TRANSACTIONS_ENABLED=false
