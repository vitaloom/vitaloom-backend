# Application
SERVER_PORT=8080

# MongoDB replica set (host-run Spring Boot app connects through localhost)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=root
MONGO_PASS=change-me-local-root-password

# Least-privilege application database account
APP_DB=vitaloom_db
APP_USER=vitaloom_app
APP_PASSWORD=change-me-local-app-password

# Mongo Express local administration UI (8082 avoids Expo/Metro's default 8081)
ME_PORT=8082
ME_BASIC_USER=admin
ME_BASIC_PASS=change-me-local-admin-password

# Browser-based clients (native React Native requests are not subject to browser CORS)
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Mongo driver / optional transaction support
MONGO_SERVER_SELECTION_TIMEOUT_MS=2000
MONGO_TRANSACTIONS_ENABLED=false

# Basic authentication: supply two different cryptographically random secrets,
# each at least 32 bytes. Never commit populated values or put them in the mobile app.
# JWT_ACCESS_SECRET=<set-in-local-.env>
# JWT_REFRESH_SECRET=<set-in-local-.env>
# JWT_ISSUER=https://api.vitaloom.local

# Assistant READY FAQ. Set these only in the Backend environment or local .env.
# ASSISTANT_GEMINI_API_KEY=
# ASSISTANT_VECTOR_MONGO_URI=mongodb://127.0.0.1:27183/assistant_vector?directConnection=true&serverSelectionTimeoutMS=2000
# ASSISTANT_VECTOR_PORT=27183

# Assistant voice logging. The audio stays on the Backend host for local STT.
# ASSISTANT_VOICE_ENABLED=false
# ASSISTANT_VOICE_STT_FFMPEG=ffmpeg
# ASSISTANT_VOICE_STT_EXECUTABLE=whisper-cli
# ASSISTANT_VOICE_STT_MODEL=/path/to/ggml-base.bin
