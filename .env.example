# MongoDB root account (admin database)
MONGO_PORT=27017
MONGO_USER=root
MONGO_PASS=change-this-local-root-password

# Least-privilege application account
APP_DB=vitaloom_db
APP_USER=vitaloom_app
APP_PASSWORD=change-this-local-app-password

# Mongo Express (local development only)
ME_PORT=8081
ME_BASIC_USER=admin
ME_BASIC_PASS=change-this-local-ui-password

# MongoDB replica set
MONGO_REPLICA_SET=vitaloom-rs
